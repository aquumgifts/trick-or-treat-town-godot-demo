; Engine configuration file.

config_version=5

[application]

config/name="Trick-or-Treat Town Demo"
config/description="Walk the Trick-or-Treat Town street at night, step into the haunted house and the candy shop, and flip day to night. 16x16 pixel art by Spaceyyy. The art loads from assets/."
run/main_scene="res://scenes/street.tscn"
config/features=PackedStringArray("4.3")

[autoload]

Demo="*res://scripts/demo.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]

2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.07, 0.06, 0.1, 1)
